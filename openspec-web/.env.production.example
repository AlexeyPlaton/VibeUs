# Final legal document version displayed/accepted at registration.
# Production registration fails closed when this is absent.
VITE_LEGAL_VERSION=2026-09-01

# Public demo project shown on the landing page.
VITE_DEMO_PROJECT=demo-showcase
# Public widget key is not a secret; restrict it with project origin allow-list.
VITE_DEMO_PUBLIC_WIDGET_KEY=vb_pub_REPLACE_AFTER_SEED_OR_CREATE
