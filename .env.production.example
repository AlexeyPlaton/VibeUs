# =============================================================================
# VibeUs production example
# =============================================================================
# Copy to .env.production on the server, replace placeholders, and never commit
# real secrets. See docs/PRODUCTION_DEPLOYMENT.md and docs/BILLING.md.

ENVIRONMENT=production
DOMAIN=vibeus.pro
SERVER_URL=https://vibeus.pro
PUBLIC_BASE_URL=https://vibeus.pro
# Use a different registrable domain from the account application.
PREVIEW_BASE_URL=https://preview.vibeus-preview.net
CORS_ORIGINS=https://vibeus.pro,https://www.vibeus.pro,https://app.vibeus.pro
ENABLE_DEMO_SEED=false
ENABLE_MOCK_BILLING=false

# PostgreSQL
POSTGRES_USER=vibus_admin
POSTGRES_PASSWORD=generate_a_super_secure_password_here_12345
POSTGRES_DB=vibus_production
DATABASE_URL=postgresql+asyncpg://vibus_admin:generate_a_super_secure_password_here_12345@db:5432/vibus_production

# Security
TOKEN_PEPPER=generate_a_random_64_character_hex_pepper_key_here
FIELD_ENCRYPTION_KEY=generate_a_valid_production_encryption_key_here

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=VibeUsNotificationBot

# Commercial catalog
BILLING_PERIOD_DAYS=30
PRICING_DEFAULT_MARKET=ru
ENABLE_GLOBAL_PRICING=false
GLOBAL_BILLING_PROVIDER=cloudpayments
PRICE_RUB_SOLO=1490.00
PRICE_RUB_STUDIO=4990.00
PRICE_USD_SOLO=29.00
PRICE_USD_STUDIO=79.00

# Live payment providers are fail-closed in the public production template.
# Enable only the provider/merchant flow that is contractually available to the
# operator and has passed real webhook/refund/fiscal smoke testing.
ENABLE_YOOKASSA=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_TAX_MODE=npd
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_SUBJECT=

ENABLE_CLOUDPAYMENTS=false
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_API_BASE_URL=https://api.cloudpayments.ru
CLOUDPAYMENTS_GLOBAL_CURRENCY=USD

ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ENABLE_LAVA=false
LAVA_API_BASE_URL=https://gate.lava.top
LAVA_API_KEY=
LAVA_WEBHOOK_API_KEY=
LAVA_OFFER_ID_SOLO=
LAVA_OFFER_ID_STUDIO=

# Optional AI providers
GROQ_API_KEY=
OPENROUTER_API_KEY=

# GitHub App — preferred repository credential
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_STATE_SECRET=
GITHUB_APP_SETUP_URL=
