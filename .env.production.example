# =============================================================================
# VIBUS CLOUD (vibus.pro) - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Instructions:
# 1. Copy this file to .env.production on your VPS: cp .env.production.example .env.production
# 2. Fill in the secure tokens, database passwords, and API keys.
# 3. Do NOT commit .env.production to Git!
# =============================================================================

# --- 1. DOMAIN & HOSTING SETTINGS ---
DOMAIN=vibeus.pro
SERVER_URL=https://vibeus.pro
PUBLIC_BASE_URL=https://vibeus.pro
PREVIEW_BASE_URL=https://preview.vibeus-preview.net
CORS_ORIGINS=https://vibeus.pro,https://www.vibeus.pro,https://app.vibeus.pro

# --- 2. DATABASE CONFIGURATION (PostgreSQL) ---
POSTGRES_USER=vibus_admin
POSTGRES_PASSWORD=generate_a_super_secure_password_here_12345
POSTGRES_DB=vibus_production
# Used internally by FastAPI inside docker network
DATABASE_URL=postgresql+asyncpg://vibus_admin:generate_a_super_secure_password_here_12345@db:5432/vibus_production

# --- 3. SECURITY & CRYPTO KEYS ---
# Generate using: python3 -c 'import secrets; print(secrets.token_hex(32))'
TOKEN_PEPPER=generate_a_random_64_character_hex_pepper_key_here
FIELD_ENCRYPTION_KEY=generate_a_fernet_32_byte_base64_encryption_key_here

# --- 4. TELEGRAM BOT (Team Notifications) ---
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_NAME=VibusNotificationBot

# --- 5. PAYMENT GATEWAYS ---
# For Russian payments via YooKassa:
ENABLE_YOOKASSA=true
# Tax Mode: 'npd' (Самозанятый, чек через сервис "Мой налог", ККТ не требуется)
#           'kkt_54fz' (ИП/ООО на ОСНО/УСН с онлайн-кассой по 54-ФЗ)
BILLING_TAX_MODE=npd

YOOKASSA_SHOP_ID=your_yookassa_shop_id_here
YOOKASSA_SECRET_KEY=your_yookassa_secret_key_here

# Fiscal parameters below are ONLY required if BILLING_TAX_MODE=kkt_54fz:
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_SUBJECT=

# For International payments via Stripe (requires ENABLE_GLOBAL_PRICING=true):
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
STRIPE_PRICE_ID_PRO=price_pro_12usd_monthly
STRIPE_PRICE_ID_TEAM=price_team_35usd_monthly

# --- 6. AI PROVIDER (Optional Platform Fallback) ---
# Groq / OpenRouter / OpenAI fallback key if users don't bring their own key
GROQ_API_KEY=
OPENROUTER_API_KEY=
