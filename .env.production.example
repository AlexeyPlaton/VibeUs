# =============================================================================
# VIBEUS CLOUD (vibeus.pro) - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Instructions:
# 1. Copy this file to .env.production on your VPS.
# 2. Fill in secure tokens, database passwords, and enabled provider keys.
# 3. Do NOT commit .env.production to Git.
# =============================================================================

# --- 1. DOMAIN & HOSTING SETTINGS ---
ENVIRONMENT=production
DOMAIN=vibeus.pro
SERVER_URL=https://vibeus.pro
PUBLIC_BASE_URL=https://vibeus.pro
PREVIEW_BASE_URL=https://preview.vibeus-preview.net
CORS_ORIGINS=https://vibeus.pro,https://www.vibeus.pro,https://app.vibeus.pro
ENABLE_DEMO_SEED=false
ENABLE_MOCK_BILLING=false

# --- 2. DATABASE CONFIGURATION (PostgreSQL) ---
POSTGRES_USER=vibus_admin
POSTGRES_PASSWORD=generate_a_super_secure_password_here_12345
POSTGRES_DB=vibus_production
DATABASE_URL=postgresql+asyncpg://vibus_admin:generate_a_super_secure_password_here_12345@db:5432/vibus_production

# --- 3. SECURITY & CRYPTO KEYS ---
TOKEN_PEPPER=generate_a_random_64_character_hex_pepper_key_here
FIELD_ENCRYPTION_KEY=generate_a_valid_production_encryption_key_here

# --- 4. TELEGRAM BOT (Optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=VibeUsNotificationBot

# --- 5. COMMERCIAL CATALOG ---
BILLING_PERIOD_DAYS=30
PRICING_DEFAULT_MARKET=ru
ENABLE_GLOBAL_PRICING=false
GLOBAL_BILLING_PROVIDER=lava
PRICE_RUB_SOLO=1490.00
PRICE_RUB_STUDIO=4990.00
PRICE_USD_SOLO=29.00
PRICE_USD_STUDIO=79.00

# --- 6. RUSSIAN PAYMENTS VIA YOOKASSA ---
ENABLE_YOOKASSA=true
BILLING_TAX_MODE=npd
YOOKASSA_SHOP_ID=your_yookassa_shop_id_here
YOOKASSA_SECRET_KEY=your_yookassa_secret_key_here
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_SUBJECT=

# --- 7. INTERNATIONAL PAYMENTS ---
# Stripe remains available to self-hosting operators that are independently
# eligible for Stripe. It is disabled in the canonical RF-operated deployment.
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LAVA readiness. DO NOT set ENABLE_LAVA=true merely because keys exist.
# First complete LAVA verification and obtain written confirmation from LAVA
# support that the hosted VibeUs SaaS/software-service use case is accepted.
ENABLE_LAVA=false
LAVA_API_BASE_URL=https://gate.lava.top
LAVA_API_KEY=
LAVA_WEBHOOK_API_KEY=
LAVA_OFFER_ID_SOLO=
LAVA_OFFER_ID_STUDIO=

# Activation sequence after written provider approval:
#   1) configure the two Price-on-request offers and IDs;
#   2) configure a Payment result webhook protected with LAVA_WEBHOOK_API_KEY;
#   3) deploy the activation patch that binds payment.success to the VibeUs ledger;
#   4) run a real low-value/normal-price payment smoke test;
#   5) only then set ENABLE_GLOBAL_PRICING=true and ENABLE_LAVA=true.

# --- 8. AI PROVIDERS (Optional) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
