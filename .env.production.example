# =============================================================================
# VIBEUS CLOUD (vibeus.pro) - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# 1. Copy this file to .env.production on the VPS.
# 2. Replace every placeholder with the real deployment value.
# 3. Never commit .env.production or provider secrets.
# =============================================================================

# --- 1. DOMAIN & HOSTING SETTINGS ---
ENVIRONMENT=production
DOMAIN=vibeus.pro
SERVER_URL=https://vibeus.pro
PUBLIC_BASE_URL=https://vibeus.pro
PREVIEW_BASE_URL=https://preview.vibeus-preview.net
CORS_ORIGINS=https://vibeus.pro,https://www.vibeus.pro,https://app.vibeus.pro
ENABLE_DEMO_SEED=false
ENABLE_MOCK_BILLING=false

# --- 2. DATABASE CONFIGURATION (PostgreSQL) ---
POSTGRES_USER=vibus_admin
POSTGRES_PASSWORD=generate_a_super_secure_password_here_12345
POSTGRES_DB=vibus_production
DATABASE_URL=postgresql+asyncpg://vibus_admin:generate_a_super_secure_password_here_12345@db:5432/vibus_production

# --- 3. SECURITY & CRYPTO KEYS ---
TOKEN_PEPPER=generate_a_random_64_character_hex_pepper_key_here
FIELD_ENCRYPTION_KEY=generate_a_valid_production_encryption_key_here

# --- 4. TELEGRAM BOT (Optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=VibeUsNotificationBot

# --- 5. COMMERCIAL CATALOG ---
BILLING_PERIOD_DAYS=30
PRICING_DEFAULT_MARKET=ru
ENABLE_GLOBAL_PRICING=false
GLOBAL_BILLING_PROVIDER=cloudpayments
PRICE_RUB_SOLO=1490.00
PRICE_RUB_STUDIO=4990.00
PRICE_USD_SOLO=29.00
PRICE_USD_STUDIO=79.00

# --- 6. RUSSIAN PAYMENTS VIA YOOKASSA ---
ENABLE_YOOKASSA=true
BILLING_TAX_MODE=npd
YOOKASSA_SHOP_ID=your_yookassa_shop_id_here
YOOKASSA_SECRET_KEY=your_yookassa_secret_key_here
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_SUBJECT=

# --- 7. INTERNATIONAL PAYMENTS ---
# Canonical hosted international adapter for the RF-operated deployment.
# Keep it disabled until the merchant contract is approved, credentials are
# issued, foreign-card acceptance is enabled and the actual fiscal setup has
# been reviewed for the merchant account.
ENABLE_CLOUDPAYMENTS=false
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_API_BASE_URL=https://api.cloudpayments.ru
CLOUDPAYMENTS_GLOBAL_CURRENCY=USD

# Configure these HTTPS notifications in the CloudPayments merchant cabinet
# only for the production domain/account that owns the credentials:
# Check  -> https://YOUR_DOMAIN/api/billing/cloudpayments/check
# Pay    -> https://YOUR_DOMAIN/api/billing/cloudpayments/pay
# Fail   -> https://YOUR_DOMAIN/api/billing/cloudpayments/fail
# Refund -> https://YOUR_DOMAIN/api/billing/cloudpayments/refund

# Stripe remains optional for self-hosting operators that are independently
# eligible for Stripe. It is disabled in the canonical RF-operated deployment.
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LAVA.TOP remains an optional candidate for a separately approved deployment.
# It is not the canonical hosted VibeUs provider. Do not enable it unless the
# operator and actual SaaS use case are explicitly accepted by the provider.
ENABLE_LAVA=false
LAVA_API_BASE_URL=https://gate.lava.top
LAVA_API_KEY=
LAVA_WEBHOOK_API_KEY=
LAVA_OFFER_ID_SOLO=
LAVA_OFFER_ID_STUDIO=

# --- 8. AI PROVIDERS (Optional) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- 9. GITHUB APP (Preferred; PAT is legacy fallback) ---
# The App is resolved by exact owner/repo. VibeUs does not persist a browser-
# supplied installation ID and uses short-lived repository installation tokens.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Base64-encoded RSA PEM private key. Never commit the real private key.
GITHUB_APP_PRIVATE_KEY_B64=
# Optional dedicated HMAC secret for the signed install callback state. If empty,
# TOKEN_PEPPER is used. Keep either value at least 32 random characters/bytes.
GITHUB_APP_STATE_SECRET=
# Optional override. Otherwise this is derived as:
# https://vibeus.pro/app/integrations/github/callback
GITHUB_APP_SETUP_URL=
