# =============================================================================
# VibeUs Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.
# See docs/SELF_HOSTING.md for detailed configuration guidance.

# Database connection string
# For development (SQLite — zero setup):
#   DATABASE_URL=sqlite+aiosqlite:///./vibus.db
# For production (PostgreSQL — recommended):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/vibus

# Security & Admin
TOKEN_PEPPER=change-me-use-at-least-32-random-bytes
FIELD_ENCRYPTION_KEY=change-me-use-a-valid-production-encryption-key
ADMIN_SECRET=change-me-to-a-secure-admin-secret-at-least-32-chars
ENABLE_MOCK_BILLING=false
ENVIRONMENT=development

# CORS allowed origins (comma-separated; wildcard is forbidden in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
PREVIEW_BASE_URL=http://127.0.0.1:8000

# Telegram Bot Token (optional — for team notifications)
TELEGRAM_BOT_TOKEN=

# =============================================================================
# Billing Configuration
# =============================================================================
BILLING_PERIOD_DAYS=30
PRICING_DEFAULT_MARKET=ru
ENABLE_GLOBAL_PRICING=false
GLOBAL_BILLING_PROVIDER=cloudpayments

# Canonical prices
PRICE_RUB_SOLO=1490.00
PRICE_RUB_STUDIO=4990.00
PRICE_USD_SOLO=29.00
PRICE_USD_STUDIO=79.00

# YooKassa — Russian market
ENABLE_YOOKASSA=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_TAX_MODE=npd
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_SUBJECT=

# CloudPayments — preferred international-card adapter for a Russia-based
# operator after CloudPayments approves the merchant/site and enables foreign
# cards. The public ID identifies the terminal; API secret stays server-side and
# validates webhook HMAC signatures.
ENABLE_CLOUDPAYMENTS=false
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_API_BASE_URL=https://api.cloudpayments.ru
CLOUDPAYMENTS_GLOBAL_CURRENCY=USD

# Configure CloudPayments notifications in the merchant cabinet:
# Check  -> https://YOUR_DOMAIN/api/billing/cloudpayments/check
# Pay    -> https://YOUR_DOMAIN/api/billing/cloudpayments/pay
# Fail   -> https://YOUR_DOMAIN/api/billing/cloudpayments/fail
# Refund -> https://YOUR_DOMAIN/api/billing/cloudpayments/refund

# Stripe — optional international provider for operators eligible for Stripe
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LAVA.TOP — optional checkout candidate. Keep disabled unless your account and
# actual hosted SaaS use case are explicitly approved by the provider.
ENABLE_LAVA=false
LAVA_API_BASE_URL=https://gate.lava.top
LAVA_API_KEY=
LAVA_WEBHOOK_API_KEY=
LAVA_OFFER_ID_SOLO=
LAVA_OFFER_ID_STUDIO=

# Optional AI providers
GROQ_API_KEY=
OPENROUTER_API_KEY=

# GitHub App — preferred repository credential for hosted/self-hosted VibeUs.
# Create a GitHub App with repository permissions appropriate for your workflow
# (Contents/Pull requests/Issues write; Checks/Deployments read). App credentials
# belong to the VibeUs server, never to browser code. PAT remains legacy fallback.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Base64-encoded RSA PEM private key. Never commit the real private key.
GITHUB_APP_PRIVATE_KEY_B64=
