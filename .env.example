# =============================================================================
# Vibus Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.
# See docs/SELF_HOSTING.md for detailed configuration guide.

# Database connection string
# For development (SQLite — zero setup):
#   DATABASE_URL=sqlite+aiosqlite:///./vibus.db
# For production (PostgreSQL — recommended):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/vibus

# Secret key for security operations (change in production!)
SECRET_KEY=change-me-in-production-use-a-long-random-string

# CORS allowed origins (comma-separated, or * for development)
# Example: https://yourdomain.com,https://staging.yourdomain.com
CORS_ORIGINS=*

# Telegram Bot Token (optional — for team notifications)
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Security & Admin
ADMIN_SECRET=change-me-to-a-secure-admin-secret-at-least-32-chars
ALLOW_MOCK_BILLING=false
ENV=production

# =============================================================================
# Billing Configuration
# =============================================================================
# ЮKassa (For Russian market: RUB, Cards, СБП, SberPay, 54-FZ receipts)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PRICE_RUB_SOLO=990.00
PRICE_RUB_STUDIO=2990.00

# Stripe (For international market: USD, EUR — requires non-RU legal entity)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SOLO=price_solo_19usd_monthly
STRIPE_PRICE_ID_STUDIO=price_studio_49usd_monthly


# Default Admin Account (Used by seed script on first run)
VIBUS_ADMIN_EMAIL=admin@vibus.local
VIBUS_ADMIN_PASSWORD=admin123
