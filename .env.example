# =============================================================================
# VibeUs Configuration
# =============================================================================
# Copy to .env and update values for your environment.
# See docs/SELF_HOSTING.md and docs/BILLING.md.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/vibus

# Security
TOKEN_PEPPER=change-me-use-at-least-32-random-bytes
FIELD_ENCRYPTION_KEY=change-me-use-a-valid-production-encryption-key
ADMIN_SECRET=change-me-to-a-secure-admin-secret-at-least-32-chars
ENVIRONMENT=development

# Browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
PREVIEW_BASE_URL=http://127.0.0.1:8000

# Optional notifications
TELEGRAM_BOT_TOKEN=

# =============================================================================
# Billing
# =============================================================================
# Public examples keep every live provider disabled. Enable only a provider and
# merchant flow that you are actually permitted to use and have tested.
ENABLE_MOCK_BILLING=false
BILLING_PERIOD_DAYS=30
PRICING_DEFAULT_MARKET=ru
ENABLE_GLOBAL_PRICING=false
GLOBAL_BILLING_PROVIDER=cloudpayments
PRICE_RUB_SOLO=1490.00
PRICE_RUB_STUDIO=4990.00
PRICE_USD_SOLO=29.00
PRICE_USD_STUDIO=79.00

# YooKassa adapter
ENABLE_YOOKASSA=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_TAX_MODE=npd
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_SUBJECT=

# CloudPayments adapter
ENABLE_CLOUDPAYMENTS=false
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_API_BASE_URL=https://api.cloudpayments.ru
CLOUDPAYMENTS_GLOBAL_CURRENCY=USD

# Stripe adapter
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LAVA adapter
ENABLE_LAVA=false
LAVA_API_BASE_URL=https://gate.lava.top
LAVA_API_KEY=
LAVA_WEBHOOK_API_KEY=
LAVA_OFFER_ID_SOLO=
LAVA_OFFER_ID_STUDIO=

# Optional AI providers
GROQ_API_KEY=
OPENROUTER_API_KEY=

# GitHub App — preferred repository credential
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_B64=
# Optional dedicated HMAC secret for signed installation state. If empty,
# TOKEN_PEPPER is used.
GITHUB_APP_STATE_SECRET=
# Optional callback override. Otherwise PUBLIC_BASE_URL + the built-in callback.
GITHUB_APP_SETUP_URL=
