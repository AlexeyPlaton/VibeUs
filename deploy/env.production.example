# VibeUs production example — fill with real values; do not commit secrets.
ENVIRONMENT=production

# Main SaaS/account/API origin. Keep browser UI and account API same-origin.
PUBLIC_BASE_URL=https://vibeus.pro

# IMPORTANT: use a DIFFERENT registrable domain from the account application.
# Do not use preview.vibeus.pro if app.vibeus.pro holds sensitive browser state.
PREVIEW_BASE_URL=https://preview.vibeus-preview.net

# Trusted browser origins used for cookie-auth CSRF checks. This is NOT the
# customer-widget allow-list; customer origins are stored per project.
CORS_ORIGINS=https://vibeus.pro

# PostgreSQL in the RF data-localization perimeter for RF personal data.
DATABASE_URL=postgresql+asyncpg://vibeus:CHANGE_ME@postgres:5432/vibeus

# Generate independently, >= 32 random bytes each. Never reuse.
TOKEN_PEPPER=CHANGE_ME_64_RANDOM_CHARS
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_RANDOM_CHARS

BROWSER_SESSION_COOKIE_NAME=vibeus_session
PREVIEW_SESSION_COOKIE_NAME=vibeus_preview_session

ENABLE_PUBLIC_TUNNELS=true
ENABLE_MCP_WRITE=true
ENABLE_ENHANCED_DIAGNOSTICS=false
ENABLE_DEMO_SEED=false
ENABLE_MOCK_BILLING=false

# Reserved for the distributed realtime/tunnel implementation. The current
# release candidate must still be deployed with ONE application worker.
REDIS_URL=redis://redis:6379/0

# Primary RF billing path.
ENABLE_YOOKASSA=true
YOOKASSA_SHOP_ID=CHANGE_ME
YOOKASSA_SECRET_KEY=CHANGE_ME

# Tax/fiscal mode. For a self-employed NPD seller, YooKassa accepts the payment
# while the seller registers income and issues the buyer receipt in 'Мой налог'.
BILLING_TAX_MODE=npd

# Required only when BILLING_TAX_MODE=kkt_54fz. Leave empty in NPD mode.
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_SUBJECT=

# Canonical commercial catalog. These values drive backend billing and the
# public /api/public/pricing endpoint consumed by landing/create/dashboard.
BILLING_PERIOD_DAYS=30
PRICING_DEFAULT_MARKET=ru
ENABLE_GLOBAL_PRICING=false
GLOBAL_BILLING_PROVIDER=cloudpayments
PRICE_RUB_SOLO=1490.00
PRICE_RUB_STUDIO=4990.00
PRICE_USD_SOLO=29.00
PRICE_USD_STUDIO=79.00

# Canonical hosted international adapter for the RF-operated service. Keep it
# disabled until CloudPayments approves the merchant/site, foreign-card
# acceptance is enabled, credentials are issued and the actual fiscal setup is
# reviewed for the merchant account.
ENABLE_CLOUDPAYMENTS=false
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_API_BASE_URL=https://api.cloudpayments.ru
CLOUDPAYMENTS_GLOBAL_CURRENCY=USD

# Production CloudPayments notifications:
# Check  -> https://YOUR_DOMAIN/api/billing/cloudpayments/check
# Pay    -> https://YOUR_DOMAIN/api/billing/cloudpayments/pay
# Fail   -> https://YOUR_DOMAIN/api/billing/cloudpayments/fail
# Refund -> https://YOUR_DOMAIN/api/billing/cloudpayments/refund

# Optional Stripe adapter for self-hosting operators that are independently
# eligible for Stripe. It remains disabled in the canonical RF deployment.
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LAVA.TOP remains an optional candidate for separately approved deployments.
# It is not the canonical hosted VibeUs international provider.
ENABLE_LAVA=false
LAVA_API_BASE_URL=https://gate.lava.top
LAVA_API_KEY=
LAVA_WEBHOOK_API_KEY=
LAVA_OFFER_ID_SOLO=
LAVA_OFFER_ID_STUDIO=

# Preferred GitHub repository credential. Configure one GitHub App on the
# VibeUs server; users install it only on repositories they want VibeUs to use.
# PAT remains a legacy fallback during migration.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Base64-encoded RSA PEM private key. Never commit the real private key.
GITHUB_APP_PRIVATE_KEY_B64=
